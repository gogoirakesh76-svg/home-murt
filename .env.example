# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Admin credentials override (recommended for production deployments).
# If left unset, the first-run Admin Claim screen on /admin lets you configure your admin account securely.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
